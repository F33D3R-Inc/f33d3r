# F33D3R Production Caddyfile
# Caddy automatically provisions Let's Encrypt TLS for f33d3r.com.
# Requires ports 80 and 443 open and DNS pointing to this server.



f33d3r.com {
  header Onion-Location "http://f33d3rrec452wpd5qyabjy4fomrph6ljrc4o37ug3423qd7kcp4gb4yd.onion{uri}"
  # Compress text responses — exclude the SSE channel (/api/events), which must
  # stream unbuffered (see flush_interval -1 below) or facet frames never arrive.
  @compressible not path /api/events
  encode @compressible zstd gzip
  reverse_proxy feed-engine:8081 {
    header_up Host {host}
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-Proto https
    # Required for the FA Live SSE stream (/api/events) — the persistent connection
    # that delivers facet mutations and Gnosis message events. Without this Caddy
    # buffers the response and stream frames never reach the client.
    flush_interval -1
  }
}

help.f33d3r.com {
  reverse_proxy help-center:8080 {
    header_up Host {host}
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-Proto https
  }
}


