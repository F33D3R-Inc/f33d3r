{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "title": "F33D3R · Overview",
  "tags": ["f33d3r", "platform"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [

    { "type": "row", "title": "Platform Health", "gridPos": {"h":1,"w":24,"x":0,"y":0}, "collapsed": false, "id": 1 },

    {
      "type": "stat", "id": 2,
      "title": "Brains Up",
      "gridPos": {"h":4,"w":4,"x":0,"y":1},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [{"expr":"count(up{job=~\"nantar|aethyrrank|zior|caeor|vovin|ain-soph|aethyr-ledger|verity|elohim-veni|zodacare|schema-registry|registrar\"} == 1)","refId":"A","instant":true}],
      "options": {"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"value","graphMode":"none","textMode":"auto"},
      "fieldConfig": {"defaults":{"thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"yellow","value":10},{"color":"green","value":13}]},"mappings":[]}}
    },

    {
      "type": "stat", "id": 3,
      "title": "Brains Down",
      "gridPos": {"h":4,"w":4,"x":4,"y":1},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [{"expr":"count(up{job=~\"nantar|aethyrrank|zior|caeor|vovin|ain-soph|aethyr-ledger|verity|elohim-veni|zodacare|schema-registry|registrar\"} == 0) OR vector(0)","refId":"A","instant":true}],
      "options": {"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background","graphMode":"none"},
      "fieldConfig": {"defaults":{"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"red","value":1}]},"mappings":[]}}
    },

    {
      "type": "stat", "id": 4,
      "title": "Req/s (Nantar)",
      "gridPos": {"h":4,"w":4,"x":8,"y":1},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [{"expr":"sum(rate(http_requests_total{brain=\"nantar\"}[1m]))","refId":"A","instant":true}],
      "options": {"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"value","graphMode":"area"},
      "fieldConfig": {"defaults":{"unit":"reqps","decimals":1}}
    },

    {
      "type": "stat", "id": 5,
      "title": "p95 Latency (Nantar)",
      "gridPos": {"h":4,"w":4,"x":12,"y":1},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [{"expr":"histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{brain=\"nantar\"}[5m])) by (le))","refId":"A","instant":true}],
      "options": {"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"value","graphMode":"none"},
      "fieldConfig": {"defaults":{"unit":"s","decimals":3,"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":0.2},{"color":"red","value":0.3}]}}}
    },

    {
      "type": "stat", "id": 6,
      "title": "Host CPU",
      "gridPos": {"h":4,"w":4,"x":16,"y":1},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [{"expr":"1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))","refId":"A","instant":true}],
      "options": {"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"value","graphMode":"area"},
      "fieldConfig": {"defaults":{"unit":"percentunit","decimals":1,"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":0.5},{"color":"red","value":0.8}]}}}
    },

    {
      "type": "stat", "id": 7,
      "title": "Host RAM Used",
      "gridPos": {"h":4,"w":4,"x":20,"y":1},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [{"expr":"1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes","refId":"A","instant":true}],
      "options": {"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"value","graphMode":"none"},
      "fieldConfig": {"defaults":{"unit":"percentunit","decimals":1,"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":0.7},{"color":"red","value":0.9}]}}}
    },

    { "type": "row", "title": "Brain Status", "gridPos": {"h":1,"w":24,"x":0,"y":5}, "collapsed": false, "id": 8 },

    {
      "type": "table", "id": 9,
      "title": "Brain Up / Down",
      "gridPos": {"h":7,"w":24,"x":0,"y":6},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [{"expr":"up{job=~\"nantar|aethyrrank|zior|caeor|vovin|ain-soph|aethyr-ledger|verity|elohim-veni|zodacare|schema-registry|registrar\"}","refId":"A","instant":true,"legendFormat":"{{job}}"}],
      "options": {"sortBy":[{"displayName":"Value","desc":false}]},
      "transformations": [
        {"id":"labelsToFields","options":{"valueLabel":"job"}},
        {"id":"organize","options":{"renameByName":{"job":"Brain","Value":"Status"},"excludeByName":{"Time":true,"instance":true,"cluster":true,"region":true,"tier":true}}}
      ],
      "fieldConfig": {
        "overrides": [{
          "matcher": {"id":"byName","options":"Status"},
          "properties": [{
            "id":"mappings",
            "value":[{"type":"value","options":{"0":{"text":"DOWN","color":"red","index":0},"1":{"text":"UP","color":"green","index":1}}}]
          },{"id":"custom.displayMode","value":"color-background"}]
        }]
      }
    },

    { "type": "row", "title": "Request Metrics", "gridPos": {"h":1,"w":24,"x":0,"y":13}, "collapsed": false, "id": 10 },

    {
      "type": "timeseries", "id": 11,
      "title": "Request Rate (per brain)",
      "gridPos": {"h":8,"w":12,"x":0,"y":14},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [{"expr":"sum by (brain) (rate(http_requests_total[1m]))","legendFormat":"{{brain}}","refId":"A"}],
      "fieldConfig": {"defaults":{"unit":"reqps","custom":{"lineWidth":2,"fillOpacity":10}}}
    },

    {
      "type": "timeseries", "id": 12,
      "title": "p95 Latency (per brain)",
      "gridPos": {"h":8,"w":12,"x":12,"y":14},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [{"expr":"histogram_quantile(0.95, sum by (brain, le) (rate(http_request_duration_seconds_bucket[5m])))","legendFormat":"{{brain}}","refId":"A"}],
      "fieldConfig": {"defaults":{"unit":"s","custom":{"lineWidth":2,"fillOpacity":10},"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":0.2},{"color":"red","value":0.3}]}}}
    },

    { "type": "row", "title": "Errors & In-Flight", "gridPos": {"h":1,"w":24,"x":0,"y":22}, "collapsed": false, "id": 13 },

    {
      "type": "timeseries", "id": 14,
      "title": "5xx Error Rate (per brain)",
      "gridPos": {"h":8,"w":12,"x":0,"y":23},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [{"expr":"sum by (brain) (rate(http_requests_total{status=~\"5..\"}[5m])) / sum by (brain) (rate(http_requests_total[5m]))","legendFormat":"{{brain}}","refId":"A"}],
      "fieldConfig": {"defaults":{"unit":"percentunit","custom":{"lineWidth":2,"fillOpacity":20},"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":0.001},{"color":"red","value":0.01}]}}}
    },

    {
      "type": "timeseries", "id": 15,
      "title": "In-Flight Requests (per brain)",
      "gridPos": {"h":8,"w":12,"x":12,"y":23},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [{"expr":"sum by (brain) (http_requests_in_flight)","legendFormat":"{{brain}}","refId":"A"}],
      "fieldConfig": {"defaults":{"unit":"short","custom":{"lineWidth":2,"fillOpacity":10}}}
    },

    { "type": "row", "title": "Process Resources", "gridPos": {"h":1,"w":24,"x":0,"y":31}, "collapsed": false, "id": 16 },

    {
      "type": "timeseries", "id": 17,
      "title": "CPU Usage (per brain)",
      "description": "process_cpu_seconds_total — only brains exposing /metrics with ProcessCollector will appear. All brains show after S0.2 lands.",
      "gridPos": {"h":8,"w":12,"x":0,"y":32},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [{"expr":"sum by (brain) (rate(process_cpu_seconds_total[5m]))","legendFormat":"{{brain}}","refId":"A"}],
      "fieldConfig": {"defaults":{"unit":"percentunit","custom":{"lineWidth":2,"fillOpacity":10}}}
    },

    {
      "type": "timeseries", "id": 18,
      "title": "Memory (RSS, per brain)",
      "description": "process_resident_memory_bytes — only brains exposing /metrics will appear.",
      "gridPos": {"h":8,"w":12,"x":12,"y":32},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [{"expr":"process_resident_memory_bytes","legendFormat":"{{brain}}{{job}}","refId":"A"}],
      "fieldConfig": {"defaults":{"unit":"bytes","custom":{"lineWidth":2,"fillOpacity":10}}}
    },

    { "type": "row", "title": "Host & Storage", "gridPos": {"h":1,"w":24,"x":0,"y":40}, "collapsed": false, "id": 19 },

    {
      "type": "timeseries", "id": 20,
      "title": "Host CPU (per mode)",
      "gridPos": {"h":8,"w":12,"x":0,"y":41},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [
        {"expr":"rate(node_cpu_seconds_total{mode!=\"idle\"}[5m])","legendFormat":"{{mode}} cpu{{cpu}}","refId":"A"}
      ],
      "fieldConfig": {"defaults":{"unit":"percentunit","custom":{"lineWidth":1,"fillOpacity":5}}}
    },

    {
      "type": "timeseries", "id": 21,
      "title": "Disk Used %",
      "gridPos": {"h":8,"w":12,"x":12,"y":41},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [{"expr":"1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|devtmpfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|devtmpfs\"}","legendFormat":"{{mountpoint}}","refId":"A"}],
      "fieldConfig": {"defaults":{"unit":"percentunit","custom":{"lineWidth":2,"fillOpacity":10},"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":0.7},{"color":"red","value":0.85}]}}}
    },

    { "type": "row", "title": "Database", "gridPos": {"h":1,"w":24,"x":0,"y":49}, "collapsed": false, "id": 22 },

    {
      "type": "timeseries", "id": 23,
      "title": "PgBouncer Pool Size",
      "gridPos": {"h":8,"w":12,"x":0,"y":50},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [{"expr":"pgbouncer_databases_pool_size","legendFormat":"{{database}}","refId":"A"}],
      "fieldConfig": {"defaults":{"unit":"short","custom":{"lineWidth":2,"fillOpacity":10},"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":50},{"color":"red","value":65}]}}}
    },

    {
      "type": "timeseries", "id": 24,
      "title": "MinIO — Object Storage",
      "gridPos": {"h":8,"w":12,"x":12,"y":50},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [
        {"expr":"minio_cluster_capacity_usable_free_bytes","legendFormat":"Free","refId":"A"},
        {"expr":"minio_cluster_capacity_usable_total_bytes - minio_cluster_capacity_usable_free_bytes","legendFormat":"Used","refId":"B"}
      ],
      "fieldConfig": {"defaults":{"unit":"bytes","custom":{"lineWidth":2,"fillOpacity":10}}}
    },

    { "type": "row", "title": "Logs", "gridPos": {"h":1,"w":24,"x":0,"y":58}, "collapsed": false, "id": 25 },

    {
      "type": "logs", "id": 26,
      "title": "Recent Errors (all brains)",
      "datasource": {"type":"loki","uid":"loki"},
      "gridPos": {"h":12,"w":24,"x":0,"y":59},
      "targets": [{"expr":"{cluster=\"f33d3r-local\"} |= `\"level\":\"error\"` or |= `level=error`","refId":"A","maxLines":200}],
      "options": {"dedupStrategy":"none","enableLogDetails":true,"prettifyLogMessage":false,"showLabels":true,"showTime":true,"sortOrder":"Descending","wrapLogMessage":true}
    },

    {
      "type": "logs", "id": 27,
      "title": "All logs (tail)",
      "datasource": {"type":"loki","uid":"loki"},
      "gridPos": {"h":12,"w":24,"x":0,"y":71},
      "targets": [{"expr":"{cluster=\"f33d3r-local\"}","refId":"A","maxLines":100}],
      "options": {"dedupStrategy":"none","enableLogDetails":true,"prettifyLogMessage":false,"showLabels":true,"showTime":true,"sortOrder":"Descending","wrapLogMessage":false}
    }

  ]
}
