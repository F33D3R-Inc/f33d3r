# F33D3R Production Environment — Template
# Copy to .env.prod and fill in real values before deploying.
# .env.prod is git-ignored and must never be committed.
#
#   cp .env.prod.example .env.prod && nano .env.prod
#
# This file is the COMPLETE contract for docker-compose.prod.yml.
# Every variable below is referenced as ${VAR} in that compose file —
# nothing else reaches the containers (there is no per-service env_file).
#
# ══════════════════════════════════════════════════════════════════════════════
#  REQUIRED — deploy is insecure or broken until these are set to real values.
# ══════════════════════════════════════════════════════════════════════════════
# Big Balls Sports API key — the only name this key has. Set → the sports lane
# runs on Big Balls; empty → it runs on ESPN's keyless scoreboard. Either way
# the lane is always on.
BBS_API=
# ── Postgres ──────────────────────────────────────────────────────────────────
# POSTGRES_USER / POSTGRES_DB default to "f33d3r" if omitted; password is REQUIRED.
POSTGRES_USER=f33d3r
POSTGRES_DB=f33d3r
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_random_password

# ── Session signing ───────────────────────────────────────────────────────────
# Signs PIAL session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_-base64_48

# ── Internal service-to-service auth ──────────────────────────────────────────
# Shared secret for brain-to-brain API calls: Manhattan authenticates every call
# into the naming plane with it, and every Rust brain plus feed-engine sends it;
# Verity, Ain Soph and Themis guard their mutating routes with it. Manhattan and
# the brains refuse to boot without it. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=CHANGE_ME

# ── Contact key-bundle signing ────────────────────────────────────────────────
# Ed25519 seed elohim-veni signs contact key bundles with, so a Number holder can
# tell the bundle they received is the one the key directory issued. UNSET is not
# an error and not a warning: bundles simply ship with "signed": false and every
# recipient loses that check, which is why it belongs here rather than being
# discovered in production. 32 bytes, base64. Generate with: openssl rand -base64 32
CONTACT_BUNDLE_SIGNING_SEED=

# ── NSFW media token ──────────────────────────────────────────────────────────
# HMAC secret for signing NSFW media URLs (5-min expiry tokens, D-005).
# Generate with: openssl rand -base64 48
MEDIA_TOKEN_SECRET=CHANGE_ME_media_token_generate_with_openssl_rand_-base64_48

# ── Themis ECDH private key (paid-content CEK unwrap) ──────────────────────────
# P-256 private key in PKCS#8 DER, base64-encoded (single line). If unset, Themis
# falls back to a RANDOM ephemeral key on every restart, which permanently breaks
# decryption of all previously-sold content. Generate with:
#   openssl ecparam -name prime256v1 -genkey -noout \
#     | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 -w0
THEMIS_ECDH_PRIVKEY_B64=CHANGE_ME_generate_with_openssl_ecparam

# ══════════════════════════════════════════════════════════════════════════════
#  OPTIONAL — safe to leave at the defaults shown; features degrade if blank.
# ══════════════════════════════════════════════════════════════════════════════

# ── Prometheus metrics auth ───────────────────────────────────────────────────
# If set, /metrics requires Authorization: Bearer <token>. Leave empty only if
# /metrics is network-gated. Generate with: openssl rand -hex 24
METRICS_TOKEN=CHANGE_ME_metrics_generate_with_openssl_rand_-hex_24

# ── Stripe (fiat payments) ────────────────────────────────────────────────────
# Leave blank to disable Stripe. Get from the Stripe dashboard.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── XRP ledger websocket ──────────────────────────────────────────────────────
# Defaults to the public node if blank.
XRP_WS_URL=wss://xrpl.ws

# ── Tiingo (cashtag / market data, feed-engine) ───────────────────────────────
# Leave blank to disable $TICKER market data.
TIINGO_API_KEY=

# ── Sports (game cards, feed-engine) ─────────────────────────────────────────
# ALWAYS ON — no off switch. BBS_API above selects Big Balls; empty selects
# ESPN's public scoreboard (one poller for the platform: 20s while a game is
# being played, 30m when the next game is a day away; never per viewer).
# SPORTS_PROVIDER is an optional override (espn|bigballs) and cannot disable
# the lane.
SPORTS_PROVIDER=



# ── Giphy (GIF picker) ────────────────────────────────────────────────────────
# Leave blank to disable the GIF picker.
GIPHY_API=

# ── Web push / VAPID (Herald notification brain) ──────────────────────────────
# Powers browser push notifications. Leave blank to disable push (Herald falls
# back to "not-configured" and simply sends nothing). Generate a key pair with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@f33d3r.com

# ── Tor hidden service ────────────────────────────────────────────────────────
# The .onion address is derived by tor from the hidden-service key, which lives
# in the tor_hs docker volume and is NOT in git or in any image. On the very
# first start the tor container seeds that volume from
# ${TOR_HS_KEY_DIR}/hs_ed25519_secret_key when the file exists; when it does
# not, tor generates a fresh identity and the volume keeps it from then on.
# Defaults to ./infra/tor next to the compose file. A DIRECTORY, not a file
# path, so a missing key is simply absent instead of docker inventing an empty
# directory in its place.
# TOR_HS_KEY_DIR=/etc/f33d3r/tor
#
# feed-engine reads the hostname tor derived (via the tor_hostname volume) and
# emits Onion-Location on every page. Leave ONION_HOSTNAME blank so the header
# always names the address the key actually produces; set it only to advertise
# a hidden service run by a tor daemon outside this stack.
# ONION_HOSTNAME=

# ── Auralis (F33D3R Frequencies, live audio) ─────────────────────────────────
# Signs the short-lived signaling tokens handed to browsers. Auralis's own
# secret, distinct from INTERNAL_API_KEY, so a peer brain cannot mint a media
# session. At least 32 characters. Generate with: openssl rand -hex 32
AURALIS_SIGNAL_SECRET=CHANGE_ME_auralis_generate_with_openssl_rand_-hex_32

# ── Logging ───────────────────────────────────────────────────────────────────
RUST_LOG=info

# ── Feature flags ─────────────────────────────────────────────────────────────
SHOW_SCORES=false

# ── content-scan (visual / audio / text classifier) ───────────────────────────
# The live lane posts every sampled keyframe to this service and drives
# live_streams.scan_state from its verdict. Leave CONTENT_SCAN_URL unset to use
# the in-stack service; the compose default is http://content-scan:8097.
#
# When it is unreachable, feed-engine fails CLOSED: sampled frames are held at
# scan_state='pending_scan' with risk 'unscanned', never marked clean, and after
# five minutes of outage the affected streams are escalated to human_review.
# CONTENT_SCAN_URL=http://content-scan:8097

# Device for the models: cpu (default) or cuda.
# cuda additionally requires CONTENT_SCAN_RUNTIME=nvidia and a host with the
# nvidia container runtime. A cuda request the host cannot honour logs a warning
# naming the reason and runs on CPU — it never stops the service from starting.
CONTENT_SCAN_DEVICE=cpu
CONTENT_SCAN_RUNTIME=runc

# NudeNet runs under ONNX Runtime. The default CPU package has no CUDA provider;
# build with onnxruntime-gpu to put NudeNet on the GPU as well. EasyOCR and
# faster-whisper follow CONTENT_SCAN_DEVICE regardless of this setting.
CONTENT_SCAN_ONNXRUNTIME=onnxruntime

# Per-process thread cap for the math libraries (OpenMP / OpenBLAS).
CONTENT_SCAN_THREADS=4

# ── live encoding capacity ───────────────────────────────────────────────────
# Cores the live lane may spend on encoding, below the machine's total: the
# media server's ingest threads and the edge serving the segments share it.
LIVE_CPU_BUDGET_CORES=7.8
# Set to "nvidia" on a host with an NVIDIA GPU and the NVIDIA container runtime
# installed. Naming a runtime the host does not have stops mediamtx starting at
# all, so this stays unset by default.
LIVE_GPU_RUNTIME=runc
LIVE_NVENC_ENABLED=false
# Concurrent NVENC sessions the card will open. Consumer cards cap this in the
# driver and fail the next session outright rather than running it slowly, so
# measure it on the host before raising it.
LIVE_NVENC_SESSIONS=8
