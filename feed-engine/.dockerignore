# feed-engine (Nantar) — Docker build context exclusions.
# Same idea as Rust brains: don't ship local build output to Docker.

# Go build artefacts
feed-engine
*.test
*.out
vendor/

# Local IDE / OS noise
.idea/
.vscode/
.DS_Store
*.swp
*.swo

# VCS
.git/
.gitignore

# Logs + uploads (we never want local user uploads in a build context)
*.log
web/static/uploads/

# Local environment
.env
.env.local
.env.*.local

# Docker artefacts not part of the source build
docker-compose*.yml
Dockerfile.dev
.dockerignore

# Documentation
README.md
*.md
docs/
