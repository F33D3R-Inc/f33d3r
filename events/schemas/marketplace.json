{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "marketplace.*",
  "description": "Events for the Themis private Bitcoin marketplace brain. All mutations POST to /events; Nantar forwards to Themis.",
  "type": "object",
  "required": ["event_type"],
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "marketplace.shop.open",
        "marketplace.shop.close",
        "marketplace.listing.create",
        "marketplace.listing.edit",
        "marketplace.listing.delete",
        "marketplace.purchase.initiate",
        "marketplace.subscription.create",
        "marketplace.subscription.cancel"
      ]
    },
    "btc_address": {
      "type": "string",
      "description": "Bitcoin address for the shop (marketplace.shop.open)"
    },
    "title": {
      "type": "string",
      "maxLength": 120,
      "description": "Listing title (marketplace.listing.create / edit)"
    },
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "Listing description (marketplace.listing.create / edit)"
    },
    "price_sats": {
      "type": "integer",
      "minimum": 1000,
      "description": "Price in satoshis (marketplace.listing.create)"
    },
    "content_url": {
      "type": "string",
      "description": "URL of encrypted content blob at /media/... (marketplace.listing.create)"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 content hash for integrity verification"
    },
    "cek_encrypted": {
      "type": "string",
      "description": "Base64-encoded ECIES-wrapped CEK JSON (ephemeral_pub, iv, ciphertext) encrypted for Themis ECDH pubkey"
    },
    "phash": {
      "type": ["string", "null"],
      "description": "Perceptual hash for image dedup (optional)"
    },
    "visibility": {
      "type": "string",
      "enum": ["public", "subscribers_only"],
      "default": "public",
      "description": "Who can see this listing"
    },
    "listing_id": {
      "type": "string",
      "format": "uuid",
      "description": "Target listing UUID (marketplace.listing.edit / delete / purchase.initiate)"
    },
    "is_active": {
      "type": "boolean",
      "description": "Toggle listing active state (marketplace.listing.edit)"
    },
    "seller_pial": {
      "type": "string",
      "format": "uuid",
      "description": "Seller PIAL UUID for subscription events"
    }
  },
  "additionalProperties": false
}
