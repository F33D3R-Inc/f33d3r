{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "track.uploaded",
  "description": "Emitted by Nantar when an audio track is successfully uploaded and stored.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "pial_id",
    "timestamp",
    "track_id",
    "title",
    "genre"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "const": "track.uploaded"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "pial_id": {
      "type": "string",
      "format": "uuid",
      "description": "Artist PIAL UUID"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "track_id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "genre": {
      "type": "string"
    },
    "duration_secs": {
      "type": "integer",
      "minimum": 0
    },
    "file_format": {
      "type": "string",
      "enum": [
        "mp3",
        "wav",
        "flac",
        "ogg",
        "aac",
        "opus",
        "m4a",
        "mp4",
        "webm",
        "mov"
      ]
    },
    "has_cover": {
      "type": "boolean"
    },
    "price_cents": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
