{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "messaging.delivered",
  "description": "Emitted by Vovin when a message is delivered or acked by the recipient device.",
  "type": "object",
  "required": ["event_id", "event_type", "schema_version", "pial_id", "timestamp", "message_id", "status"],
  "properties": {
    "event_id":       { "type": "string", "format": "uuid" },
    "event_type":     { "type": "string", "const": "messaging.delivered" },
    "schema_version": { "type": "string", "const": "1.0" },
    "pial_id":        { "type": "string", "format": "uuid", "description": "Recipient PIAL" },
    "timestamp":      { "type": "string", "format": "date-time" },
    "message_id":     { "type": "string", "format": "uuid" },
    "sender_pial":    { "type": "string", "format": "uuid" },
    "status":         { "type": "string", "enum": ["SENT", "DELIVERED", "READ", "EXPIRED"] },
    "device_id":      { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
