{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "content.moderated",
  "description": "Emitted by Zodacare when content is flagged, reviewed, or cleared.",
  "type": "object",
  "required": ["event_id", "event_type", "schema_version", "pial_id", "timestamp", "content_id", "action"],
  "properties": {
    "event_id":       { "type": "string", "format": "uuid" },
    "event_type":     { "type": "string", "const": "content.moderated" },
    "schema_version": { "type": "string", "const": "1.0" },
    "pial_id":        { "type": "string", "format": "uuid", "description": "Content author PIAL" },
    "timestamp":      { "type": "string", "format": "date-time" },
    "content_id":     { "type": "string", "format": "uuid" },
    "content_type":   { "type": "string", "enum": ["post", "reply", "media", "profile"] },
    "action":         { "type": "string", "enum": ["flagged", "removed", "cleared", "escalated"] },
    "reason":         { "type": "string" },
    "severity":       { "type": "string", "enum": ["low", "medium", "high", "critical"] }
  },
  "additionalProperties": false
}
