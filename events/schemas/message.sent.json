{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "message.sent",
  "description": "Emitted by Vovin when an encrypted message is relayed. Contains ONLY metadata — no content, no keys, no IVs.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "pial_id",
    "timestamp",
    "recipient_pial_id",
    "message_id"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "const": "message.sent"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "pial_id": {
      "type": "string",
      "format": "uuid",
      "description": "Sender PIAL UUID"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "recipient_pial_id": {
      "type": "string",
      "format": "uuid"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "protocol_version": {
      "type": "string",
      "enum": [
        "v1-ecdh-aesgcm",
        "v2-x3dh-ratchet"
      ]
    }
  },
  "additionalProperties": false
}
