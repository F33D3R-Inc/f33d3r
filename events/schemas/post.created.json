{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "post.created",
  "description": "Emitted by Nantar when a user successfully creates a post or reply.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "pial_id",
    "timestamp",
    "post_id",
    "is_reply"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "const": "post.created"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "pial_id": {
      "type": "string",
      "format": "uuid",
      "description": "Author PIAL root UUID"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "post_id": {
      "type": "string",
      "format": "uuid"
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "is_reply": {
      "type": "boolean"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "video",
        "audio"
      ]
    },
    "body_length": {
      "type": "integer",
      "minimum": 1
    },
    "has_media": {
      "type": "boolean"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "comment_gating": {
      "type": "string",
      "enum": [
        "open",
        "followers",
        "verified",
        "none"
      ]
    },
    "surface": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
