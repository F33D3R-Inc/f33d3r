{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "identity.registered",
  "description": "Emitted by Nantar when a new PIAL root is created during user onboarding.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "pial_id",
    "timestamp",
    "handle"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "const": "identity.registered"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "pial_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "handle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "theme_id": {
      "type": "string"
    },
    "realm": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    }
  },
  "additionalProperties": false
}
