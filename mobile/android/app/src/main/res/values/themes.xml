<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window ground matches the Shell's surface so the first frame does not
         flash a lighter panel before Compose paints. The system bars are transparent
         and drawn over by the Shell's own chrome (edge to edge); their glyphs are
         light because the ground they start on is the dark surface. -->
    <style name="Theme.F33d3r" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.F33d3r.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.F33d3r</item>
    </style>
</resources>
