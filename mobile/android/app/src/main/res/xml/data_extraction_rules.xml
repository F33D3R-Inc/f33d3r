<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Nothing leaves the device. The session token and the account's messaging
         private key are sealed to a Keystore key that does not transfer, so a backup
         containing them would be a backup of ciphertext nothing can open — and the
         attempt is worth refusing outright rather than shipping useless blobs. -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
