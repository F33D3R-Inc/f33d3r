# Rust brain — Docker build context exclusions.
# Without this, target/ (multi-GB) gets shipped as build context, causing
# "Can't add file ... to tar: io: read/write on closed pipe" errors and
# 30+ min build context uploads. Sprint 0 / Session 008 fix.

target/
**/*.rs.bk
**/*.pdb

.idea/
.vscode/
.DS_Store
*.swp
*.swo

.git/
.gitignore

*.log

.env
.env.local
.env.*.local

docker-compose*.yml
Dockerfile.dev
.dockerignore

README.md
*.md
docs/
